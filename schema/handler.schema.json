{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sijba Handler Config",
  "type": "object",
  "required": ["id", "direction", "type"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "priority": {"type": "number"},
    "direction": {"type": "string", "enum": ["inbound", "outbound"]},
    "category": {"type": "array", "items": {"type": "string"}},
    "type": {"type": "string", "enum": ["exec_json", "http"]},
    "required": {"type": "boolean"},
    "await_response": {"type": "boolean"},
    "allow_direct_inject": {"type": "boolean"},
    "continue_on_match": {"type": "boolean"},
    "match": {
      "type": "object",
      "properties": {
        "regex": {"type": "string"},
        "source": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "exec": {"type": "string"},
    "args": {"type": "array", "items": {"type": "string"}},
    "timeout_seconds": {"type": "number"},
    "context": {
      "type": "object",
      "description": "If set, core loads context from the store before invoking the plugin and saves context_update from the response.",
      "properties": {
        "namespace": {"type": "string", "description": "Store namespace (defaults to handler id)"},
        "key": {"type": "string", "description": "Field from source_meta to use as store key (default: chat_id)"}
      },
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "description": "Extra environment variables passed to the spawned process. Values support ${VAR} substitution from the host environment.",
      "additionalProperties": {"type": "string"}
    },
    "router_hint": {
      "type": "string",
      "description": "Short description + example commands for the router LLM to understand when to route to this handler."
    },
    "receive_handler_context": {
      "type": "boolean",
      "description": "If true, core injects a 'handlers' summary (id + router_hint) into the envelope before invoking this plugin."
    },
    "startup": {
      "type": "object",
      "properties": {
        "url": {"type": "string"},
        "invoke_path": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
